# ──────────────────────────────────────────────────────────────────────
# Sepolia deployment configuration (contracts/.env)
#
# 1. Copy this file to contracts/.env       (Windows: copy .env.example .env)
# 2. Fill in the real values below.
# 3. NEVER commit contracts/.env — it is already listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────

# JSON-RPC endpoint for the Sepolia testnet.
# Create a free app at https://www.alchemy.com (or Infura / QuickNode /
# PublicNode) and copy its Sepolia URL, e.g.:
#   https://eth-sepolia.g.alchemy.com/v2/<YOUR_API_KEY>
SEPOLIA_RPC_URL=

# Private key of a DEDICATED DEVELOPMENT WALLET that holds TEST ETH ONLY.
# Create a brand-new wallet in MetaMask just for this project, export its
# private key (Account details → Show private key), and fund it from a
# Sepolia faucet (see the README).
#
# ⚠️  NEVER use a key that controls real funds.
# ⚠️  NEVER commit this value anywhere.
PRIVATE_KEY=

# Optional: Etherscan API key, used only for `npx hardhat verify` on Sepolia.
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
