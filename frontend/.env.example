# ──────────────────────────────────────────────────────────────────────
# Frontend configuration (frontend/.env.local)
#
# 1. Copy this file to frontend/.env.local  (Windows: copy .env.example .env.local)
# 2. Fill in the contract address after deploying to Sepolia.
# 3. Only PUBLIC values belong here — NEVER put private keys in the frontend.
# ──────────────────────────────────────────────────────────────────────

# Address of the deployed SimpleStorage contract on Sepolia.
# Copy it from contracts/deployments/sepolia.json after running:
#   cd contracts && npm run deploy:sepolia
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: read-only JSON-RPC endpoint used to fetch contract data.
# Defaults to a public Sepolia endpoint when not set.
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
